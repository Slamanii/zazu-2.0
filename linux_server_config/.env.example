WEBHOOK_SECRET=
DEV_MODE=false
SUPABASE_URL=https://your-project.supabase.co
# Server only: required to read protected bot_token values.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Telegram numeric ID of a main bot also stored in telegram_bots.
# Unassigned pool bots are never started unless explicitly selected here.
ZAZU_MAIN_BOT_ID=
# ASAP backend: base URL and the shared x-asap-secret (same value as the backend's ASAP_WEBHOOK_SECRET).
ASAP_BASE_URL=
ASAP_WEBHOOK_SECRET=
# Public base URL the ASAP backend calls back on (no trailing slash). Defaults to PUBLIC_URL.
ZAZU_CALLBACK_URL=
# Give up after this many no-driver retries per order. 0 = keep retrying (default).
NO_DRIVER_MAX_RETRIES=0
