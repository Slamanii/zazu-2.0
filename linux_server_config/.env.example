WEBHOOK_SECRET=
DEV_MODE=false
SUPABASE_URL=https://your-project.supabase.co
# Server only: required to read protected bot_token values.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Telegram numeric ID or bot_id value, e.g. zazu_main_bot.
# Unassigned pool bots are never started unless explicitly selected here.
ZAZU_MAIN_BOT_ID=

# Local SSH connection settings, not used by the bot application.
ZAZU_VPS_IP_ADDRESS=
ZAZU_VPS_IP_USERNAME=ubuntu
ZAZU_VPS_IP_PASSWORD=
