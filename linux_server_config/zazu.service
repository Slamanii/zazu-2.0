[Unit]
Description=Zazu app
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Projects/zazu-2.0
EnvironmentFile=/home/ubuntu/Projects/zazu-2.0/linux_server_config/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
